# Signal Desk — environment template. Copy to `.env` and fill in. NEVER commit the real .env.

# --- Discord bot / gateway ---
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_APPROVAL_USER_ID=your-discord-user-id
DISCORD_APPROVAL_TIMEOUT_SECONDS=120
# channelID:providerLabel, comma-separated
CHANNELS=123456789:jmt,234567890:prince

# --- Alerts (Discord webhook or any webhook-compatible endpoint) ---
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- Interactive Brokers (TWS / IB Gateway) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497            # 7497 TWS paper, 7496 TWS live, 4002 GW paper, 4001 GW live
IBKR_CLIENT_ID=80
IBKR_MARKET_DATA_TYPE=2   # 1 live, 2 frozen, 3 delayed, 4 delayed-frozen
IBKR_IV_CLIENT_ID=81
IV_RANK_USE_IBKR=1
PDT_EXEMPT=0

# --- Anthropic (LLM fallback classifier) ---
ANTHROPIC_API_KEY=sk-ant-your-key
