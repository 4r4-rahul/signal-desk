# secrets — NEVER commit
.env
*.key

# python / venv
.venv/
__pycache__/
*.pyc

# data & local db / journals
data/*.json
# safe_io rolling backups — local recovery only, not versioned
channels/.bak/
channels/*/*.db
channels/*/messages.json
channels/*/journal.csv
channels/*/live_signals.md

# derived data warehouse (rebuild: python3 db.py backfill)
signal_desk.db
signal_desk.db-journal
signal_desk.db.bak-*
# ad-hoc timestamped rescue copies (safe_io + manual pre-migration backups)
*.bak
*.bak.[0-9]*
ml_dataset.csv

# daily day-stop override (ephemeral, auto-expires)
channels/_day_override

# routing eval scratch — cached LLM classifications, regenerable by re-running
# `python3 llm_eval.py route-live`. Delete after changing the prompt or the model.
eval/.route_cache.json
# router conversational context — a cache of desk state, rebuilt from SIGNALS on startup
channels/_route_context.json
channels/_msg_context.json
inbox

# personal positions, scraped feeds and runtime logs stay local
channels/_positions.json
channels/_feed.json
channels/_feed_seen.json
logs/
